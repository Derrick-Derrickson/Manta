part PLUG2 {
    @type  = cableconnector;
    @mates = [BACKPLANE-OUT, BACKPLANE-IN];

    [1:2] = P[1:2]<>;
};

part CRIMP {
    @type = crimp;

    1 = A &CASUAL;
    2 = B &CASUAL;
};

part WIRE {
    @type = wire;
    #csa  = 1mm2;

    1 = A &CASUAL;
    2 = B &CASUAL;
};

cable jumper-8way {
    {K1~PLUG2}P[1:2]
        = [[.{X%[1:2]~CRIMP}. = .{W%[1:2]~WIRE}. = .{Y%[1:2]~CRIMP}.]]
        = P[1:2]{K2~PLUG2};
};
