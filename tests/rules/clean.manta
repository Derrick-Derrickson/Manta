// The same shape, decorated so that every rule is satisfied. This is the half
// that proves the rules do not fire on correct work.
part REG-AMPLE {
    @~footprint = SOT-23-5;
    1 : VOUT> &TYPE=POWER #SUPPLY=600mA;
    2 : GND<  &TYPE=POWER;
};

part DRV-5V {
    @~footprint = SOT-23;
    1 : Q>   #VOH=4V5 #VOL=0V4;
    2 : VCC< &TYPE=POWER #DRAW=20mA;
    3 : GND< &TYPE=POWER;
};

part RX-5V-OK {
    @~footprint = SOT-23;
    1 : D<   #VIH=3V5 #VIL=1V5;
    2 : VCC< &TYPE=POWER #DRAW=200mA;
    3 : GND< &TYPE=POWER;
};

block b {
    GND &TYPE=GROUND;
    RAIL = VOUT.{U1~REG-AMPLE: .GND = GND;};
    RAIL = 3V3;
    SIG = Q.{U2~DRV-5V: .VCC = 3V3; .GND = GND;};
    SIG = D.{U3~RX-5V-OK: .VCC = 3V3; .GND = GND;};
};
