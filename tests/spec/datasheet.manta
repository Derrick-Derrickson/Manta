// Spec section 2.8 -- a file carrying its own datasheet.
//
// The declaration is manta; everything after the marker is not, and every tool
// reproduces it byte for byte.
part STM32F0QA5 {
    @VERSION       = 1.1+;
    @~footprint    = QFP-32;
    #value         = STM32F0QA5;
    #!manufacturer = "ST Microelectronics";

    1 : VCC< &TYPE=POWER;
    2 : GND< &TYPE=POWER;
};

---

# STM32F0QA5

