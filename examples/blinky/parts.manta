// Part library for the blinky example. One declaration per part; the
// datasheet excerpts for the actives live in their own files, after the
// end-of-content marker, so a designer reads the part and its facts together.
//
// Every part carries a weak '@~footprint' naming a package, never a library:
// blinky.fpmap says what KiCad calls each package. Nothing here is 'static',
// because a library part has to be visible to the board that uses it.

// ---- passives -------------------------------------------------------------

part R-0R-0603 {
    @~footprint = R-0603;
    #value      = 0R;
    #power      = 100mW;
    @!type      = resistor;
    #~mpn       = "RC0603JR-070RL";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part R-1kR-0603 {
    @~footprint = R-0603;
    #value      = 1kR;
    #tolerance  = ±1%;
    #power      = 100mW;
    @!type      = resistor;
    #~mpn       = "RC0603FR-071KL";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part R-5k1R-0603 {
    @~footprint = R-0603;
    #value      = 5k1R;
    #tolerance  = ±1%;
    #power      = 100mW;
    @!type      = resistor;
    #~mpn       = "RC0603FR-075K1L";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part R-10kR-0603 {
    @~footprint = R-0603;
    #value      = 10kR;
    #tolerance  = ±1%;
    #power      = 100mW;
    @!type      = resistor;
    #~mpn       = "RC0603FR-0710KL";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part R-100kR-0603 {
    @~footprint = R-0603;
    #value      = 100kR;
    #tolerance  = ±1%;
    #power      = 100mW;
    @!type      = resistor;
    #~mpn       = "RC0603FR-07100KL";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part C-100nF-0603 {
    @~footprint = C-0603;
    #value      = 100nF;
    #voltage    = 50V;
    #dielectric = X7R;
    @!type      = capacitor;

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part C-1uF-0603 {
    @~footprint = C-0603;
    #value      = 1uF;
    #voltage    = 25V;
    #dielectric = X7R;
    @!type      = capacitor;

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part C-10uF-0805 {
    @~footprint = C-0805;
    #value      = 10uF;
    #voltage    = 25V;
    #dielectric = X5R;
    @!type      = capacitor;

    1 : A &CASUAL;
    2 : B &CASUAL;
};

// ---- LEDs -------------------------------------------------------------------
// KiCad's LED footprints put the cathode on pad 1, so the pin map does too.

part LED-0603 {
    @~footprint = LED-0603;
    #value      = green;
    @!type      = led;
    #~current   = 5mA;
    #vf         = 2V4;

    1 : K;
    2 : A;
};

part LED-BICOLOUR {
    @~footprint = LED-KPA-3010;
    #value      = "red/green";
    @!type      = led;
    #~mpn       = "KPA-3010SURKCGKC";

    1 : A[0];    // red anode
    2 : A[1];    // green anode
    3 : K;       // common cathode
};

// ---- switches and test points ---------------------------------------------

part SW-DIP-2 {
    @~footprint = DIP-2-SMD;
    #value      = "DIP x2";
    @!type      = switch;
    #~mpn       = "219-2LPST";

    // Two independent poles: pads 1 and 4 face each other across the body,
    // as do 2 and 3. Each pole's two contacts are interchangeable.
    1 : A1 &CASUAL;
    2 : A2 &CASUAL;
    3 : B2 &CASUAL;
    4 : B1 &CASUAL;
};

// ---- connectors -------------------------------------------------------------
// A header's positions carry no roles: what each one means is bound on the
// board, where a reader can see it.

part HDR-1x04 {
    @~footprint = HDR-1x04;
    #value      = "1x4 2.54mm";
    @!type      = boardconnector;
    @~mate      = i2c-lead;

    [1:4] : P[1:4]<>;
};

part HDR-1x05 {
    @~footprint = HDR-1x05;
    #value      = "1x5 2.54mm";
    @!type      = boardconnector;
    @~mate      = swd-lead;

    [1:5] : P[1:5]<>;
};

part CONN-USB-C {
    @~footprint = USB-C-7;
    #value      = USB-C;
    @!type      = boardconnector;
    @~mate      = usb-c-1m;

    1     : VBUS>      &TYPE=POWER #SUPPLY=500mA;
    2     : GND<       &TYPE=POWER;
    3     : CC1<>      &SWAP=cc;
    4     : CC2<>      &SWAP=cc;
    [5:6] : USB.[+,-]<>;
    7     : SHIELD;
};

// ---- cable parts ------------------------------------------------------------
// Plugs, crimps and wires need no footprint: they are on the loom's BOM,
// never on the board.

part USB-C-PLUG {
    @type  = cableconnector;
    @mates = CONN-USB-C;
    #~mpn  = "USB-C-PLUG-7";

    [1:7] : P[1:7]<>;
};

part SWD-PLUG {
    @type  = cableconnector;
    @mates = HDR-1x05;
    // The pod's ribbon is crimped mirrored, so position 1 meets header pin 5.
    @map   = [[1:5, 5:1]];
    #~mpn  = "DF3-5S-2C";

    [1:5] : P[1:5]<>;
};

part HDR-1x04-PLUG {
    @type  = cableconnector;
    @mates = HDR-1x04;
    #~mpn  = "DF3-4S-2C";

    [1:4] : P[1:4]<>;
};

part SWD-POD-PLUG {
    @type = cableconnector;
    #~mpn = "DF3-5S-2C";

    [1:5] : P[1:5]<>;
};

part CRIMP-24AWG {
    @type = crimp;
    #mpn  = "AMP-1734592-1";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part WIRE-24AWG-RED {
    @type       = wire;
    #csa        = 205000um2;   // AWG24
    #strands    = 7;
    #colour     = red;
    #insulation = PVC;
    #mpn        = "3257-RD-100";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

part WIRE-26AWG-GREY {
    @type       = wire;
    #csa        = 129000um2;   // AWG26
    #strands    = 7;
    #colour     = grey;
    #insulation = PVC;
    #mpn        = "3251-GY-100";

    1 : A &CASUAL;
    2 : B &CASUAL;
};

---

# Passives and connectors

Commodity parts, specified by value, package and tolerance; any pin-compatible
manufacturer's part is a substitute. The resistor figures below are Yageo's
RC0603 series specification (V.4, 2009), which the MPNs name.

## Resistors, RC0603

| Parameter | Value |
|---|---|
| Power rating | 100 mW at 70 °C, derated linearly to 0 at 155 °C |
| Maximum working voltage | 50 V |
| Maximum overload voltage | 100 V |
| Temperature coefficient | ±100 ppm/°C |
| Operating temperature | −55 to +155 °C |
| Package | 1.60 × 0.80 × 0.45 mm, two end terminations |

## Capacitors

Multilayer ceramic, class II dielectric as stated on each part. A class II
capacitor loses capacitance under DC bias; the 25 V and 50 V ratings here are
chosen so that at 5 V and below the loss is small.

## Headers, 2.54 mm

Single-row through-hole pin headers. Pins are numbered from the position with
the square pad. Rated 3 A per contact, 250 V.
