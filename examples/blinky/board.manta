// blinky -- a USB-powered indicator board.
//
// USB-C in, a 3V3 LDO, an STM32F042 with USB and I2C, two indicator LEDs, a
// bicolour status LED, two configuration switches, a VBUS sense divider and
// an SWD debug header. It passes every check with nothing to report, and it
// uses every construct the language has, so it doubles as a tour.

// An indicator: a series resistor and an LED to ground. The resistor value
// is a parameter so the same block serves LEDs of different brightness.
block indicator {
    @VERSION    = 1.4+;
    @FLATFORMAT = "$INSTANCE$_$COMPONENT$";
    #~series-r  = 1;

    >DRIVE;
    >>GND;

    DRIVE = .{R1~R-$"series-r"$kR-0603}. = LED-ANODE = A.{D1~LED-0603}.K = GND;
    LED-ANODE &RENDER=WIRE;
};

// A bare copper pad for a probe. Private to this board, and on no BOM.
static part TESTPOINT {
    @~footprint = TP-PAD;
    @!type      = testpoint;
    @bom        = FALSE;

    1 : TP;
};

block blinky {
    @VERSION     = 2.0+;
    #description = "USB-C powered indicator board";
    >#author     = TJM;
    #!>board-rev = B;
    #~fit-debug  = true;

    // Two grounds: the ADC's sense divider returns to an analog star that
    // meets the main ground once, through paralleled 0R links.
    GND  &TYPE=GROUND;
    AGND &TYPE=GROUND;
    AGND = (.{R9~R-0R-0603}.)|2 = GND;
    [3V3, GND]>>;

    VBUS &CLASS=power &PEAK=1A5;
    3V3  &CLASS=power &RAIL;

    --- USB-C POWER IN

    // Rd on each CC line tells the host this is a sink; 5.1k is the value
    // the USB-C specification names, one per line so the host can tell
    // which way up the plug is. Both rows' D+ and D- pads go to the one
    // pair, and the three extra VBUS and GND pads are the same conductors,
    // joined below. The shell is bonded at the enclosure, not on the board,
    // so its pad is left alone on purpose.
    {J1~CONN-USB-C: &EDGE=LEFT;
        .GND-A1 = GND;
        .VBUS   = VBUS;
        .CC1    = CC1;
        .DP-A   = USB.+;
        .DM-A   = USB.-;
        .SBU1   = ?;
        .GND-B1 = GND;
        .CC2    = CC2;
        .DP-B   = USB.+;
        .DM-B   = USB.-;
        .SBU2   = ?;
    };
    VBUS = [VBUS-A9,VBUS-B4,VBUS-B9].{J1};
    GND  = [GND-A12,GND-B12].{J1};
    CC1 = .{R1~R-5k1R-0603}. = GND;
    CC2 = .{R2~R-5k1R-0603}. = GND;
    USB-SHIELD = J1.SHIELD &STUB;

    // The data pair runs through the ESD array, one line per pad pair, so
    // the protection sits in series with no stub.
    USB     &HARNESS=usb2;
    MCU-USB &HARNESS=usb2;
    USB.+ = IO1-A.{U3~USBLC6-2SC6: .GND = GND; .VBUS = VBUS;}.IO1-B = MCU-USB.+;
    USB.- = IO2-A.{U3}.IO2-B = MCU-USB.-;
    USB.+     &MATCH=usb-pair;
    USB.-     &MATCH=usb-pair;
    MCU-USB.+ &MATCH=usb-pair;
    MCU-USB.- &MATCH={usb-pair: @!tolerance=50ps};

    --- 3V3 REGULATOR

    // Bulk and bypass on VBUS, then the LDO, then the 1uF its datasheet
    // wants on the output. EN tied to the input: always on.
    VBUS = .{C1~C-10uF-0805: .=GND} == .{C2~C-100nF-0603: .=GND}
        == VIN.{U1~LDO-3V3: .EN = VBUS; .GND = GND; .NC = ?;}.VOUT
        = 3V3 = .{C3~C-1uF-0603: .=GND} &!VOLTAGE=6V;

    --- VBUS SENSE

    // 3:1 divider into ADC_IN0, three of one resistor value: full scale at
    // 5.5V on VBUS is 1.83V. The bottom leg returns to the analog ground.
    VBUS = (.{R%[6:7]~R-100kR-0603}.)+2
        = VBUS-SENSE
        = .{R8~R-100kR-0603: #!mpn = "ERJ-3EKF1003V";}. = AGND;
    VBUS-SENSE &SHIELD=GND &~LAYER=top;

    --- MCU

    // Every pin, in pin order. USB is on PA9/PA10 by remap, I2C on PF0/PF1,
    // so no crystal is needed and every port pin is free for I/O.
    {U2~MCU-STM32F042:
        .BOOT0    = BOOT0;
        .PF0      = i2c.SDA;
        .PF1      = i2c.SCL;
        .NRST     = NRST;
        .VDDA     = 3V3 #DRAW=2mA;
        .PA[0]    = VBUS-SENSE;
        .PA[1:2]  = LED-BI-GPIO[0:1];
        .PA[3:4]  = LED-DRIVE[0:1];
        .PA[5]    = PWM[0];
        .PA[6:7]  = CFG[0:1];
        .PB1      = PWM[1];
        .VSS      = GND;
        .VDD      = 3V3 #DRAW=30mA;
        .PA[9]    = MCU-USB.-;
        .PA[10]   = MCU-USB.+;
        .PA[13]   = swd.IO;
        .PA[14]   = swd.CLK;
    };

    // One bypass to each ground: the digital VDD's, and the ADC reference's
    // return to the analog star.
    3V3 = ({C%[4:5]~C-100nF-0603: .=%[GND,AGND]}.)*2;

    // Reset: pull-up and filter. The header in DEBUG resets the part too.
    3V3 = .{R3~R-10kR-0603}. = NRST = .{C6~C-100nF-0603: .=GND};

    // BOOT0 held low for user flash. The 0R to 3V3 is placed and not fitted:
    // solder it to reach the ROM bootloader over USB.
    BOOT0 = .{R4~R-10kR-0603}. = GND;
    {!R5~R-0R-0603: .A = BOOT0; .B = 3V3;};

    // Two PWM outputs averaged into one analog level on a probe pad.
    PWM[0:1] = [[.{R%[10:11]~R-100kR-0603}.]] =* DAC-OUT = .{C7~C-100nF-0603: .=GND};
    DAC-OUT = TP.{TP1~TESTPOINT};

    --- I2C

    // Open drain, held up by its pull-ups, brought to a Qwiic connector,
    // whose I2C pair is bound as a whole. The shell pads are grounded.
    i2c &HARNESS=i2c-bus;
    3V3 = .{R13~R-10kR-0603}. = i2c.SDA;
    3V3 = .{R14~R-10kR-0603}. = i2c.SCL;
    {J2~CONN-QWIIC: &EDGE=RIGHT;
        .GND   = GND;
        .3V3   = 3V3;
        .I2C   = i2c;
        .MOUNT = GND;
    };

    --- CONFIG

    // Two option switches read at boot, pulled up so an open switch reads 1.
    // Each pole is its own pair of pads on the one package.
    3V3 *= CFG-PULL[0:1];
    CFG-PULL[0:1] = [[.{R%[11:12]~R-10kR-0603}.]] = CFG[0:1];
    CFG[0] = A1.{SW1~SW-DIP-2}.B1 = GND ^ CFG[1] = A2.{SW1}.B2 = GND;
    CFG[0:1] &RENDER=LABEL;

    --- INDICATORS

    // One indicator block per drive line; the bus width sets the count.
    LED-DRIVE[0:1] = [[{BLK%[1:2]~indicator: #series-r = 1;}.DRIVE]];

    // The bicolour LED takes both drives on its two anodes and returns
    // through its common cathode, so it is a two-in one-out unit.
    LED-BI-GPIO[0:1] = [[.{R%[15:16]~R-1kR-0603}.]]
        = [2[ A[0:1].{D3~LED-BICOLOUR}.K ]1] = GND;

    --- DEBUG

    // SWD header, fitted on development builds only.
    {J3~HDR-1x05: &EDGE=BOTTOM; @fitted=$"fit-debug"$;
        .P[1] = 3V3;
        .P[2] = swd.IO;
        .P[3] = swd.CLK;
        .P[4] = NRST;
        .P[5] = GND;
    };
};
